{
  "name": "dsh-settings-sync",
  "version": "0.1.0",
  "description": "Sync every DeepSeek Harness setting — profile config, skills, installed plugins, MCP servers and per-plugin settings — to a private Git repository, with one-click backup and restore.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elfgzp/dsh-settings-sync.git"
  },
  "homepage": "https://github.com/elfgzp/dsh-settings-sync",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "settings",
    "backup",
    "sync",
    "git"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "test/*.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "check": "for f in index.js client.js lib/*.js test/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  }
}
